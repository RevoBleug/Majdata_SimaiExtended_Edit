<Window x:Class="MajdataEdit.SvBrush.SvBrushWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SV 曲线刷" Height="560" Width="680"
        MinHeight="420" MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackground}"
        Foreground="{DynamicResource ButtonForeground}">
    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,9,10,0">
            <Button x:Name="TabStandard" Tag="0" Content="标准形状" Width="84" Height="24" Margin="0,0,6,0"
                    FontSize="12"
                    Template="{DynamicResource DarkButton}"
                    Background="{DynamicResource ButtonsBackground}"
                    Foreground="{DynamicResource ButtonForeground}"
                    Click="Tab_Click" />
            <Button x:Name="TabSpecial" Tag="1" Content="特殊类型" Width="84" Height="24" Margin="0,0,6,0"
                    FontSize="12"
                    Template="{DynamicResource DarkButton}"
                    Background="Transparent"
                    Foreground="#FF9A9A9A"
                    Click="Tab_Click" />
            <Button x:Name="TabPreset" Tag="2" Content="预设" Width="84" Height="24"
                    FontSize="12"
                    Template="{DynamicResource DarkButton}"
                    Background="Transparent"
                    Foreground="#FF9A9A9A"
                    Click="Tab_Click" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="172" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="ShapeList" Grid.Column="0"
                     Background="#FF262626" Foreground="{DynamicResource ButtonForeground}"
                     BorderBrush="#FF3C3C3C" BorderThickness="1" FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="ShapeList_SelectionChanged" />

            <ListBox x:Name="PresetList" Grid.Column="0" Visibility="Collapsed"
                     Background="#FF262626" Foreground="{DynamicResource ButtonForeground}"
                     BorderBrush="#FF3C3C3C" BorderThickness="1" FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="PresetList_SelectionChanged" />

            <ScrollViewer x:Name="ParamScroll" Grid.Column="1" Margin="12,0,0,0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="ParamPanel" />
            </ScrollViewer>

            <StackPanel x:Name="PresetPanel" Grid.Column="1" Margin="12,0,0,0" Visibility="Collapsed">
                <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="#FF8A8A8A"
                           Text="预设会把「形状 + 全部参数」一起存下来。先在标准形状或特殊类型里调好，再在这里起个名字保存。" />

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBox x:Name="PresetNameBox" Width="190" Height="23"
                             VerticalContentAlignment="Center" FontSize="12"
                             Background="{DynamicResource ButtonsBackground}"
                             Foreground="{DynamicResource ButtonForeground}"
                             BorderBrush="#FF3C3C3C" />
                    <Button Content="保存当前" Width="88" Height="23" Margin="8,0,0,0" FontSize="12"
                            Template="{DynamicResource DarkButton}"
                            Background="{DynamicResource ButtonsBackground}"
                            Foreground="{DynamicResource ButtonForeground}"
                            Click="SavePreset_Click" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Content="应用到当前" Width="88" Height="23" FontSize="12"
                            Template="{DynamicResource DarkButton}"
                            Background="{DynamicResource ButtonsBackground}"
                            Foreground="{DynamicResource ButtonForeground}"
                            Click="ApplyPreset_Click" />
                    <Button Content="删除" Width="70" Height="23" Margin="8,0,0,0" FontSize="12"
                            Template="{DynamicResource DarkButton}"
                            Background="{DynamicResource ButtonsBackground}"
                            Foreground="{DynamicResource ButtonForeground}"
                            Click="DeletePreset_Click" />
                </StackPanel>

                <TextBlock x:Name="PresetStatus" Margin="0,12,0,0" FontSize="11.5"
                           TextWrapping="Wrap" Foreground="#FF8A8A8A" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="#FF3C3C3C" Padding="10,8,10,10">
            <StackPanel>
                <TextBlock x:Name="SummaryText" Text="—" TextWrapping="Wrap"
                           Foreground="#FFB9B9B9" FontSize="12" Margin="0,0,0,8" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox x:Name="FoldCheck" Grid.Column="0" Content="渐变折叠"
                              Template="{DynamicResource DarkCheck}"
                              Foreground="{DynamicResource ButtonForeground}"
                              VerticalAlignment="Center"
                              Checked="Option_Changed" Unchecked="Option_Changed"
                              ToolTip="把近似直线的段压成 &lt;SV*值##秒数&gt;，减少指令数量，速度变成连续变化" />

                    <TextBlock Grid.Column="1" Text="小数位" Margin="16,0,6,0"
                               VerticalAlignment="Center" FontSize="12"
                               Foreground="#FFB9B9B9" />

                    <TextBox x:Name="DecimalsBox" Grid.Column="2" Width="46" Height="22"
                             VerticalContentAlignment="Center" Text="3"
                             Background="{DynamicResource ButtonsBackground}"
                             Foreground="{DynamicResource ButtonForeground}"
                             BorderBrush="#FF3C3C3C"
                             TextChanged="Decimals_Changed" />

                    <Button Grid.Column="4" Content="关闭" Width="76" Height="26" Margin="0,0,8,0"
                            Background="{DynamicResource ButtonsBackground}"
                            Foreground="{DynamicResource ButtonForeground}"
                            Template="{DynamicResource DarkButton}"
                            Click="Cancel_Click" />

                    <Button x:Name="ApplyButton" Grid.Column="5" Content="写入" Width="76" Height="26"
                            Background="#FF2D6FA8"
                            Foreground="{DynamicResource ButtonForeground}"
                            Template="{DynamicResource DarkButton}"
                            Click="Apply_Click" />
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
